# WUP ThinServer — copy to .env and adjust. .env is git-ignored: never
# commit real passwords or secrets.

# Linux hostname inside the container/session (default: wup-thinserver)
THIN_HOSTNAME=wup-thinserver

# Virtual desktop resolution (854x480, 1066x600, 1280x720, 1920x1080)
DESKTOP_WIDTH=1280
DESKTOP_HEIGHT=720

# Session keyboard layout / locale (e.g. fr + fr variants for AZERTY)
KEYBOARD_LAYOUT=us
KEYBOARD_VARIANT=
LOCALE=C.UTF-8

# `wup` account password — pick ONE (prefer the hash or wup-set-password):
# WUP_PASSWORD=
# WUP_PASSWORD_HASH=

# Optional in-container sudo (does NOT affect the host)
WUP_SUDO=0
WUP_SUDO_NOPASSWD=0

# Onboard on-screen keyboard
ONBOARD_DOCK_HEIGHT=190
# ONBOARD_LAYOUT=
