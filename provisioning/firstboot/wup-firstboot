#!/usr/bin/env python3
"""wup-firstboot: apply headless first-boot configuration.

Reads /boot/firmware/wup-firstboot.conf (the FAT32 BOOT partition, visible
from any PC after flashing — the rpi-image-gen equivalent of Raspberry Pi
Imager OS customization) and applies:

    wifi_ssid=...       WPA-PSK network SSID
    wifi_psk=...        passphrase, or 64-hex PreSharedKey
    password=...        new password for the wup user
    root_password=...   new root password
    hostname=...        system hostname
    ssh=on|off          enable or disable the SSH service
    ssh_password_auth=yes|no
                        allow or forbid password authentication

The file is re-applied whenever its content changes, so it also works as a
post-install configuration channel. iwd performs Wi-Fi association while
systemd-networkd keeps owning DHCP on wlan0.
"""

import hashlib
import os
import re
import subprocess
import sys

BOOT_DIR = "/boot/firmware"
CONF = os.path.join(BOOT_DIR, "wup-firstboot.conf")
APPLIED = "/var/lib/wup-firstboot.applied"
IWD_DIR = "/var/lib/iwd"
SSHD_DROPIN = "/etc/ssh/sshd_config.d/60-wup-firstboot.conf"


def log(msg):
    print(f"wup-firstboot: {msg}", file=sys.stderr)


def iwd_filename(ssid):
    """iwd.network(5): plain [A-Za-z0-9_-] SSIDs keep their name, others are
    '=' followed by the lowercase hex encoding of the SSID."""
    if re.fullmatch(r"[A-Za-z0-9_-]+", ssid):
        return ssid
    return "=" + ssid.encode("utf-8").hex()


def escape_value(value):
    """iwd keyfile escaping: backslashes, newlines and carriage returns."""
    return value.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r")


def write_wifi(ssid, psk):
    os.makedirs(IWD_DIR, mode=0o700, exist_ok=True)
    name = iwd_filename(ssid)
    if re.fullmatch(r"[0-9a-fA-F]{64}", psk or ""):
        body = f"[Security]\nPreSharedKey={psk.lower()}\n"
        ext = ".psk"
    elif psk:
        body = f"[Security]\nPassphrase={escape_value(psk)}\n"
        ext = ".psk"
    else:
        body = "# open network\n"
        ext = ".open"
    path = os.path.join(IWD_DIR, name + ext)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    log(f"Wi-Fi profile written: {name}{ext}")


def set_password(user, password):
    subprocess.run(
        ["chpasswd"],
        input=f"{user}:{password}\n",
        text=True,
        check=True,
    )
    log(f"password updated for {user}")


def set_hostname(hostname):
    if not re.fullmatch(r"[A-Za-z0-9-]{1,63}", hostname):
        raise ValueError(f"invalid hostname: {hostname!r}")
    with open("/etc/hostname", "w") as f:
        f.write(hostname + "\n")
    os.sethostname(hostname.encode())
    log(f"hostname set to {hostname}")


def set_ssh_service(state):
    if state == "on":
        subprocess.run(["systemctl", "enable", "--now", "ssh.service"], check=True)
    elif state == "off":
        subprocess.run(["systemctl", "disable", "--now", "ssh.service"], check=True)
    else:
        raise ValueError(f"ssh must be on or off, got {state!r}")
    log(f"ssh.service {state}")


def set_ssh_password_auth(enabled):
    value = "yes" if enabled else "no"
    with open(SSHD_DROPIN, "w") as f:
        f.write(f"# Managed by wup-firstboot\nPasswordAuthentication {value}\n")
    os.chmod(SSHD_DROPIN, 0o644)
    subprocess.run(["systemctl", "try-reload-or-restart", "ssh.service"],
                   check=False)
    log(f"ssh PasswordAuthentication {value}")


def main():
    # The boot partition may not be mounted yet on first boot; BOOT is its
    # filesystem label.
    if not os.path.isdir(BOOT_DIR):
        os.makedirs(BOOT_DIR, exist_ok=True)
    if "BOOT" not in open("/proc/mounts").read():
        subprocess.run(["mount", "-L", "BOOT", BOOT_DIR], check=False)
    if not os.path.isfile(CONF):
        return 0

    with open(CONF, "rb") as f:
        raw = f.read()
    digest = hashlib.sha256(raw).hexdigest()
    try:
        with open(APPLIED) as f:
            if f.read().strip() == digest:
                return 0
    except OSError:
        pass

    settings = {}
    for line in raw.decode("utf-8", "replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        settings[key.strip()] = value.strip()

    errors = []
    actions = []
    if "wifi_ssid" in settings:
        actions.append(("wifi", lambda: write_wifi(
            settings["wifi_ssid"], settings.get("wifi_psk"))))
    if "password" in settings:
        actions.append(("password", lambda: set_password("wup", settings["password"])))
    if "root_password" in settings:
        actions.append(("root_password", lambda: set_password("root", settings["root_password"])))
    if "hostname" in settings:
        actions.append(("hostname", lambda: set_hostname(settings["hostname"])))
    if "ssh" in settings:
        actions.append(("ssh", lambda: set_ssh_service(settings["ssh"].lower())))
    if "ssh_password_auth" in settings:
        actions.append(("ssh_password_auth", lambda: set_ssh_password_auth(
            settings["ssh_password_auth"].lower() in ("yes", "true", "1", "on"))))

    for name, action in actions:
        try:
            action()
        except Exception as exc:  # noqa: BLE001 - report and retry next boot
            errors.append(f"{name}: {exc}")

    if errors:
        for err in errors:
            log(f"error: {err}")
        return 1

    os.makedirs(os.path.dirname(APPLIED), exist_ok=True)
    with open(APPLIED, "w") as f:
        f.write(digest + "\n")
    log("configuration applied")
    return 0


if __name__ == "__main__":
    sys.exit(main())
