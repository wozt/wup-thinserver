# Headless Xorg on the vc4 modesetting driver (Pi 4, no monitor attached).
# The connector is forced "connected" by wup-xorg.service via debugfs, so
# modesetting finds HDMI-1 with the EDID override modes and drives the
# real CRTC — the scanout becomes the KMS capture source.
Section "Device"
    Identifier  "Card0"
    Driver      "modesetting"
EndSection

Section "Monitor"
    Identifier  "HDMI"
EndSection

Section "Screen"
    Identifier  "Screen0"
    Device      "Card0"
    Monitor     "HDMI"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "1280x720"
    EndSubSection
EndSection

Section "ServerLayout"
    Identifier  "Layout0"
    Screen      0 "Screen0" 0 0
EndSection
