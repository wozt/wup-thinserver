[Unit]
# Headless KMS X server for the vc4-kms-v3d session (Pi 4 only).
#
# The desktop must live on the real DRM scanout for capture_backend 2/3:
# Xvfb is invisible to KMS. With no monitor attached, the vc4 HDMI
# connector reports disconnected, so ExecStartPre fakes the connector
# state through debugfs and feeds a synthetic 1280x720 EDID — no kernel
# cmdline or config.txt changes required. wup-xorg owns :99; the session
# entrypoint skips Xvfb when WUP_SESSION=kms.
Description=WUP KMS X server (headless vc4)
Before=wup-thinserver.service
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug; for c in /sys/kernel/debug/dri/*/HDMI-A-1; do [ -d "$c" ] || continue; echo on > "$c/force" 2>/dev/null; [ -f /usr/lib/firmware/edid/wup-1280x720.bin ] && cat /usr/lib/firmware/edid/wup-1280x720.bin > "$c/edid_override" 2>/dev/null; done; true'
ExecStart=/usr/bin/Xorg :99 -config /etc/X11/xorg.conf.headless -logfile /tmp/xorg.log -noreset
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
